# /etc/systemd/system/firefly-api.service
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now firefly-api
#
# WorkingDirectory is not optional: engine.h resolves the handAnalysis tables and
# the strategy file through paths relative to the repository root.

[Unit]
Description=Firefly strategy API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=firefly
Group=firefly
WorkingDirectory=/opt/firefly
ExecStart=/opt/firefly/build/server --host 127.0.0.1 --port 8080 --warm
Restart=always
RestartSec=2

# The mappings are ~750 MB of clean, file backed pages the kernel can reclaim
# under pressure, so this bounds the process without fighting the page cache.
MemoryMax=4G

# Nothing is written at runtime.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/firefly

[Install]
WantedBy=multi-user.target
